# ============================================================
# MINDNEST DEMENTIA COMPANION - ENVIRONMENT CONFIGURATION
# ============================================================

# Frontend Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend Server Configuration
PORT=5000

# Google OAuth & Cloud APIs (Server-side only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PHOTOS_API_ENABLED=true

# Google Gemini AI Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Text-to-Speech (Server-side only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MALE_INDIAN_VOICE_1=your_male_indian_voice_id_1
ELEVENLABS_MALE_INDIAN_VOICE_2=your_male_indian_voice_id_2
ELEVENLABS_FEMALE_INDIAN_VOICE_1=your_female_indian_voice_id_1
ELEVENLABS_FEMALE_INDIAN_VOICE_2=your_female_indian_voice_id_2

# SMS & Telephony Notification Provider (Optional - Browser fallback provided)
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_provider_key_here

# Emergency Config (Default Indian emergency helpline: 112)
EMERGENCY_NUMBER=112

# Firebase Admin Service Account (Server-side only)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
